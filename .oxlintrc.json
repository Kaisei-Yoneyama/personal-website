{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "typescript/no-deprecated": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  }
}
